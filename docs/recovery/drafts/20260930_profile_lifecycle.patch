+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using NUnit.Framework;
+using UnityEngine;
+using Ziptide.Content;
+using Ziptide.Core;
+using Ziptide.Gameplay;
+using Ziptide.Gameplay.Tutorial;
+
+namespace Ziptide.Tests.EditMode
+{
+    // Exercise the real translator and pure core without bootstrapping XR or touching a save file.
+    [NonParallelizable]
+    public sealed class FirstHourProfileLifecycleTests
+    {
+        private readonly List<UnityEngine.Object> _owned = new List<UnityEngine.Object>();
+        private SaveSystem _save;
+        private FirstHourDirector _director;
+        private FirstHourObservationAdapter _observation;
+        private FirstHourContractDefinition _contract;
+        private SaveSystem _previousSave;
+        private FirstHourObservationAdapter _previousObservation;
+
+        [SetUp]
+        public void Setup()
+        {
+            _previousSave = SaveSystem.Instance;
+            _previousObservation = FirstHourObservationAdapter.Instance;
+            _save = Component<SaveSystem>();
+            _director = Component<FirstHourDirector>();
+            _observation = Component<FirstHourObservationAdapter>();
+            Static(typeof(SaveSystem), "Instance", _save);
+            Static(typeof(FirstHourObservationAdapter), "Instance", _observation);
+            _contract = ScriptableObject.CreateInstance<FirstHourContractDefinition>(); _owned.Add(_contract);
+            AddBeat("boot", "BOOT_PRESENTATION_READY");
+            AddBeat("new", "NEW_GAME_PROFILE_CREATED");
+            AddBeat(FirstHourObservationAdapter.LookBeatId, "PLAYER_LOOKED_AT_RILL");
+            AddBeat("outbound", "TRAVEL_W000_TO_W001_COMPLETE");
+            AddBeat("return", "TRAVEL_W001_TO_W000_COMPLETE");
+            Set(_director, "_contract", _contract);
+            Profile(ProfileSerializer.NewProfile());
+            Call("RefreshProfile");
+        }
+
+        [TearDown]
+        public void Cleanup()
+        {
+            foreach (var item in _owned) if (item != null) UnityEngine.Object.DestroyImmediate(item);
+            _owned.Clear();
+            Static(typeof(SaveSystem), "Instance", _previousSave);
+            Static(typeof(FirstHourObservationAdapter), "Instance", _previousObservation);
+        }
+
+        [Test]
+        public void NewGameAfterCompletedProfile_RebuildsAndPersistsObservedBoot()
+        {
+            var completed = CompletedThrough(4); Profile(completed); Call("RefreshProfile");
+            Assert.IsTrue(Core.IsComplete);
+            Call("OnBootReady", true);
+            var fresh = ProfileSerializer.NewProfile(); Profile(fresh);
+            Call("OnNewGameProfile", fresh);
+            Assert.AreEqual(FirstHourObservationAdapter.LookBeatId, Core.CurrentBeatId);
+            Assert.IsTrue(fresh.HasFlag(FirstHourDirector.BeatFlagPrefix + "boot"));
+            Assert.IsTrue(fresh.HasFlag(FirstHourDirector.BeatFlagPrefix + "new"));
+            Assert.IsFalse(fresh.HasFlag(FirstHourDirector.BeatFlagPrefix + "outbound"));
+            Assert.IsFalse(Get<bool>("_outboundTravelDone"));
+            Assert.IsTrue(completed.HasFlag(FirstHourDirector.BeatFlagPrefix + "return"));
+        }
+
+        [Test]
+        public void NewGameWithoutObservedBoot_DoesNotInventPresentationEvidence()
+        {
+            var fresh = ProfileSerializer.NewProfile(); Profile(fresh);
+            Call("OnNewGameProfile", fresh);
+            Assert.AreEqual("boot", Core.CurrentBeatId); Assert.IsEmpty(fresh.flags);
+        }
+
+        [Test]
+        public void SecondNewGameInOneSession_RestartsObservationAndHintLatch()
+        {
+            Call("OnBootReady", false);
+            var first = ProfileSerializer.NewProfile(); Profile(first); Call("OnNewGameProfile", first);
+            Assert.IsTrue(Core.MarkHintDelivered());
+            _director.Accept("PLAYER_LOOKED_AT_RILL");
+            Assert.AreEqual("outbound", Core.CurrentBeatId);
+            var second = ProfileSerializer.NewProfile(); Profile(second); Call("OnNewGameProfile", second);
+            Assert.AreEqual(FirstHourObservationAdapter.LookBeatId, Core.CurrentBeatId);
+            Assert.IsTrue(Core.ShouldOfferHint(100));
+            Assert.IsTrue(_observation.IsTracking);
+            Assert.AreEqual(FirstHourObservationAdapter.LookBeatId, _observation.ActiveBeatId);
+        }
+
+        [Test]
+        public void Continue_RestoresOutboundEvidenceSoReturnCanComplete()
+        {
+            var loaded = CompletedThrough(3); Profile(loaded); Call("RefreshProfile");
+            Assert.AreEqual("return", Core.CurrentBeatId);
+            Assert.IsTrue(Get<bool>("_outboundTravelDone"));
+            Call("OnTravelCompleted", ZiptideConstants.SceneW000);
+            Assert.IsTrue(Core.IsComplete);
+            Assert.IsTrue(loaded.HasFlag(FirstHourDirector.BeatFlagPrefix + "return"));
+        }
+
+        [Test]
+        public void ReplacementDetectedDuringSignal_DropsDepartingProfilesCallback()
+        {
+            var fresh = ProfileSerializer.NewProfile(); Profile(fresh);
+            _director.Accept("BOOT_PRESENTATION_READY");
+            Assert.IsEmpty(fresh.flags); Assert.AreEqual("boot", Core.CurrentBeatId);
+            _director.Accept("BOOT_PRESENTATION_READY");
+            Assert.AreEqual("new", Core.CurrentBeatId);
+        }
+
+        [Test]
+        public void UnchangedProfile_PreservesCoreAndHintLatch()
+        {
+            Profile(CompletedThrough(1)); Call("RefreshProfile");
+            var core = Core; core.MarkHintDelivered();
+            Assert.AreEqual(false, Call("RefreshProfile"));
+            Assert.AreSame(core, Core); Assert.IsFalse(Core.ShouldOfferHint(100));
+        }
+
+        [Test]
+        public void CompletedOrMissingProfile_CancelsPriorObservation()
+        {
+            Profile(CompletedThrough(1)); Call("RefreshProfile");
+            Assert.IsTrue(_observation.IsTracking);
+            Profile(CompletedThrough(4)); Call("RefreshProfile");
+            Assert.IsFalse(_observation.IsTracking);
+            Profile(null); Call("RefreshProfile");
+            _director.Accept("BOOT_PRESENTATION_READY");
+            Assert.IsNull(Core); Assert.IsFalse(_observation.IsTracking);
+        }
+
+        [Test]
+        public void MismatchedNewGameNotification_DoesNotMutateCurrentProfile()
+        {
+            var current = _save.Profile;
+            Call("OnNewGameProfile", ProfileSerializer.NewProfile());
+            Assert.IsEmpty(current.flags); Assert.AreEqual("boot", Core.CurrentBeatId);
+        }
+
+        [Test]
+        public void Replacement_DetachesOldJobAndRearmsSceneBinding()
+        {
+            Set(_director, "_job", new JobRuntime()); Set(_director, "_jobWasLive", true);
+            Profile(CompletedThrough(1)); Call("RefreshProfile");
+            Assert.IsNull(Get<JobRuntime>("_job")); Assert.IsFalse(Get<bool>("_jobWasLive"));
+            Assert.Greater(Get<float>("_rebindAt"), Time.unscaledTime);
+        }
+
+        private FirstHourProgressCore Core => Get<FirstHourProgressCore>("_core");
+        private void Profile(PlayerProfile profile) => Set(_save, "<Profile>k__BackingField", profile);
+        private PlayerProfile CompletedThrough(int last)
+        {
+            var p = ProfileSerializer.NewProfile();
+            for (int i = 0; i <= last; i++) p.SetFlag(FirstHourDirector.BeatFlagPrefix + _contract.beats[i].id);
+            return p;
+        }
+        private void AddBeat(string id, string signal)
+        {
+            _contract.beats.Add(new FirstHourBeatDefinition
+            {
+                id = id, required = true, completionSignal = new FirstHourContractReference { id = signal },
+                prerequisites = _contract.beats.Count == 0 ? new List<string>() : new List<string> { _contract.beats[_contract.beats.Count - 1].id },
+                hesitationSeconds = 1, rillLine = new FirstHourContractReference { id = "hint_" + id },
+            });
+        }
+        private T Component<T>() where T : Component
+        {
+            var go = new GameObject(typeof(T).Name); go.SetActive(false); _owned.Add(go);
+            return go.AddComponent<T>();
+        }
+        private object Call(string name, params object[] args) => typeof(FirstHourDirector)
+            .GetMethod(name, BindingFlags.Instance | BindingFlags.NonPublic).Invoke(_director, args);
+        private T Get<T>(string name) => (T)typeof(FirstHourDirector)
+            .GetField(name, BindingFlags.Instance | BindingFlags.NonPublic).GetValue(_director);
+        private static void Set(object target, string name, object value) => target.GetType()
+            .GetField(name, BindingFlags.Instance | BindingFlags.NonPublic).SetValue(target, value);
+        private static void Static(Type type, string name, object value) => type
+            .GetField("<" + name + ">k__BackingField", BindingFlags.Static | BindingFlags.NonPublic).SetValue(null, value);
+    }
+}
